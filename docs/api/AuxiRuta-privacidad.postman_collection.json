{
  "info": {
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "AuxiRuta - Privacidad entre usuarios",
    "description": "Demo persistente de propiedad. Completar IDs impresos por PrivacyDemoSetupTest y los cuatro tokens del entorno. Ejecutar en orden o manualmente; no crea solicitudes ni consume ORS."
  },
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Propietario 1', () => pm.expect(pm.response.json().licensePlate).to.eql('DEMODRV1'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/vehicles/{{privacy_vehicle1_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "value": "{{driver_token}}",
              "key": "token",
              "type": "string"
            }
          ]
        },
        "description": "HTTP esperado: 200. Preparar con PrivacyDemoSetupTest y completar los IDs impresos por el comando."
      },
      "name": "01 DRIVER 1 consulta su vehiculo"
    },
